          "timeframe": {
            "from": "now()-2h",
            "to": "now()"
          },
          "value": "fetch dt.davis.problems, from: -7d\n| filter not(dt.davis.is_duplicate)\n| filter in(\"Open Telemetry Demo\", primary_tags.app)\n| fields event.start, display_id, event.name, event.category, event.status,\n    primary_tags.business_service_name,\n    primary_tags.business_criticality,\n    root_cause_entity_name\n| sort event.start desc\n"
        },
        "visualizationSettings": {
          "autoSelectVisualization": true,
          "chartSettings": {}
