# Collector config below is based on Dynatrace OTel collector configuration guidance:
# https://docs.dynatrace.com/docs/ingest-from/opentelemetry/collector/configuration
# Exports traces, metrics, and logs to Dynatrace via OTLP/HTTP using credentials
# from the dynatrace-otelcol-dt-api-credentials secret (created in ASTROSHOP-EKS.md).
# k8sattributes processor requires the clusterRole RBAC rules defined above it.
opentelemetry-collector:
  podAnnotations:
    # Primary tags:
    metadata.dynatrace.com/primary_tags.business_service: BSN1001026
    metadata.dynatrace.com/primary_tags.business_service_name: OTel Collector
    metadata.dynatrace.com/primary_tags.business_criticality: L2
  clusterRole:
    create: true
    rules:
      - apiGroups: [""]
        resources: ["pods", "namespaces"]
        verbs: ["get", "watch", "list"]
      - apiGroups: ["apps"]
        resources: ["replicasets"]
        verbs: ["get", "list", "watch"]
      - apiGroups: ["extensions"]
        resources: ["replicasets"]
        verbs: ["get", "list", "watch"]
  extraEnvs:
    - name: DT_ENDPOINT
      valueFrom:
        secretKeyRef:
          name: dynatrace-otelcol-dt-api-credentials
          key: DT_ENDPOINT
    - name: DT_API_TOKEN
      valueFrom:
        secretKeyRef:
          name: dynatrace-otelcol-dt-api-credentials
          key: DT_API_TOKEN
    - name: CLUSTER_NAME
      valueFrom:
        secretKeyRef:
          name: dynatrace-otelcol-dt-api-credentials
          key: CLUSTER_NAME
  config:
    exporters:
      otlphttp/dynatrace:
        endpoint: "${env:DT_ENDPOINT}"
        headers:
          Authorization: "Api-Token ${env:DT_API_TOKEN}"
    processors:
      cumulativetodelta: {}
      resource/dynatrace:
        attributes:
          - key: primary_tags.monitoring_source
            value: "otel-collector"
            action: upsert
      # k8sattributes enriches spans/metrics/logs with Kubernetes metadata.
      # Configuration follows: https://docs.dynatrace.com/docs/ingest-from/opentelemetry/collector/use-cases/kubernetes/k8s-enrich
      k8sattributes:
        extract:
          metadata:
            - k8s.pod.name
            - k8s.pod.uid
            - k8s.deployment.name
            - k8s.replicaset.name
            - k8s.statefulset.name
            - k8s.daemonset.name
            - k8s.namespace.name
            - k8s.node.name
            - k8s.cluster.uid
            - k8s.container.name
          annotations:
            - from: pod
              key_regex: metadata.dynatrace.com/(.*)
              tag_name: $$1
            - from: namespace
              key_regex: metadata.dynatrace.com/(.*)
              tag_name: $$1
          labels:
            - from: pod
              key_regex: metadata.dynatrace.com/(.*)
              tag_name: $$1
            - from: namespace
              key_regex: metadata.dynatrace.com/(.*)
              tag_name: $$1
        pod_association:
          - sources:
              - from: resource_attribute
                name: k8s.pod.name
              - from: resource_attribute
                name: k8s.namespace.name
          - sources:
              - from: resource_attribute
                name: k8s.pod.ip
          - sources:
              - from: resource_attribute
                name: k8s.pod.uid
          - sources:
              - from: connection
      transform:
        error_mode: ignore
        trace_statements:
          - context: resource
            statements:
              - set(attributes["k8s.cluster.name"], "${env:CLUSTER_NAME}") where attributes["k8s.cluster.name"] == nil
        metric_statements:
          - context: resource
            statements:
              - set(attributes["k8s.cluster.name"], "${env:CLUSTER_NAME}") where attributes["k8s.cluster.name"] == nil
        log_statements:
          - context: resource
            statements:
              - set(attributes["k8s.cluster.name"], "${env:CLUSTER_NAME}") where attributes["k8s.cluster.name"] == nil
    service:
      pipelines:
        traces/dynatrace:
          receivers: [otlp]
          processors: [k8sattributes, transform, resource/dynatrace, batch]
          exporters: [otlphttp/dynatrace]
        # Replace the default metrics exporters (list is replaced, not merged) to drop otlp_http/prometheus
        metrics:
          exporters: [debug]
        metrics/dynatrace:
          receivers: [otlp]
          processors: [k8sattributes, transform, resource/dynatrace, batch, cumulativetodelta]
          exporters: [otlphttp/dynatrace]
        logs/dynatrace:
          receivers: [otlp]
          processors: [k8sattributes, transform, resource/dynatrace, batch]
          exporters: [otlphttp/dynatrace]

# Jaeger's pod template does not support custom podAnnotations, so pod labels are used
# instead (k8sattributes above also extracts metadata.dynatrace.com/* labels).
jaeger:
  jaeger:
    podLabels:
      # Primary tags:
      metadata.dynatrace.com/primary_tags.business_service: BSN1001027
      metadata.dynatrace.com/primary_tags.business_service_name: Jaeger
      metadata.dynatrace.com/primary_tags.business_criticality: L3

# Prometheus is disabled; metrics go to Dynatrace via the collector.
prometheus:
  enabled: false

# Grafana is disabled because its datasource is Prometheus.
grafana:
  enabled: false

opensearch:
  podAnnotations:
    # Primary tags:
    metadata.dynatrace.com/primary_tags.business_service: BSN1001030
    metadata.dynatrace.com/primary_tags.business_service_name: OpenSearch
    metadata.dynatrace.com/primary_tags.business_criticality: L3
